# Локальные настройки с паролями.
/.env

# Скачанные исходники эмулятора (несколько ГБ) и кэши сборки.
/.sources/

# Собранный сервер: воспроизводится командой make build.
# Слэш в начале обязателен: без него шаблон совпал бы с ЛЮБЫМ каталогом dist,
# включая scripts/tests/fixtures/dist — и фикстуры молча не попали бы в репозиторий.
/dist/

# Логи и резервные копии.
/logs/
/backups/

# Служебное
__pycache__/
*.pyc
*.orig
*.tmp
