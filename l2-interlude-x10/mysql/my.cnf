# =============================================================================
#  MariaDB под L2J. Главный источник "лагов на ровном месте" в сборках L2 —
#  не сам эмулятор, а БД: дефолтный my.cnf держит buffer pool в 128 МБ и
#  фsync-ит журнал на каждую транзакцию. Сервер на 500 онлайна пишет в базу
#  сотни апдейтов в секунду (инвентарь, скиллы, позиции при выходе).
# =============================================================================
[mysqld]

# --- InnoDB: главное ---------------------------------------------------------
# Весь рабочий набор L2J-базы (обычно 1-3 ГБ) должен помещаться в память,
# иначе каждый апдейт персонажа = поход на диск.
innodb_buffer_pool_size         = 2G
innodb_buffer_pool_instances    = 4
innodb_log_file_size            = 512M
innodb_log_buffer_size          = 64M

# 2 = сбрасывать журнал на диск раз в секунду, а не на каждый commit.
# При падении ОС теряется <=1 сек игровых действий. Для игрового сервера
# это правильный размен: даёт кратный рост write-throughput.
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = 1

# SSD/NVMe: поднимаем лимиты фоновых операций.
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8

# L2J держит пул соединений и делает много коротких запросов.
innodb_thread_concurrency       = 0
innodb_lock_wait_timeout        = 30

# --- Соединения --------------------------------------------------------------
# L2J-пул по умолчанию 10-100 коннектов на гейм + логин + запас на утилиты.
max_connections                 = 300
max_allowed_packet              = 64M
wait_timeout                    = 28800
interactive_timeout             = 28800

# --- Совместимость с дампами L2J ---------------------------------------------
# Дампы L2J писались во времена MySQL 5.x: там встречаются нулевые даты
# ('0000-00-00'), неявные дефолты и GROUP BY без всех колонок.
# STRICT-режим современной MariaDB такие дампы отвергает — импорт падает
# на середине и получается "полусервер". Ослабляем ровно настолько,
# чтобы дампы заходили.
sql_mode                        = NO_ENGINE_SUBSTITUTION
innodb_strict_mode              = OFF

# --- Кодировка ---------------------------------------------------------------
# utf8mb4 обязателен: русские ники и чат в 4-байтных плоскостях.
character-set-server            = utf8mb4
collation-server                = utf8mb4_general_ci
skip-character-set-client-handshake

# --- Прочее ------------------------------------------------------------------
skip-name-resolve               = 1
table_open_cache                = 4000
tmp_table_size                  = 128M
max_heap_table_size             = 128M

# Медленные запросы: если сервер "подтормаживает раз в минуту" — смотри сюда.
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/slow.log
long_query_time                 = 1

[client]
default-character-set = utf8mb4
