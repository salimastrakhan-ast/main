# =============================================================================
#  Lineage 2 Interlude x10 — основные настройки стенда
#  Скопируй в .env  (cp .env.example .env)  и поправь под себя.
# =============================================================================

# --- Что собираем -------------------------------------------------------------
# Git-репозиторий эмулятора (по умолчанию L2J Mobius — самая живая ветка Interlude)
L2_SOURCE_REPO=https://github.com/MobiusDevelopment/L2J_Mobius.git
L2_SOURCE_BRANCH=master

# Каталог хроники внутри репозитория. Если оставить AUTO — скрипт сборки сам
# найдёт подходящий каталог Interlude и покажет список кандидатов.
# Примеры: L2J_Mobius_C6_Interlude, L2J_Mobius_CT_0_Interlude,
#          L2J_Mobius_Classic_Interlude
L2_CHRONICLE=AUTO

# --- Профиль рейтов -----------------------------------------------------------
# Файл из config/profiles/<PROFILE>.conf
L2_PROFILE=x10-classic

# --- Сеть ---------------------------------------------------------------------
# IP, который логин-сервер отдаёт клиенту в списке серверов.
# localhost — играешь только с этой же машины.
# Для игры по локальной сети укажи LAN-IP (192.168.x.x),
# для интернета — белый внешний IP или домен.
L2_EXTERNAL_IP=127.0.0.1

# Адрес для игроков из той же локальной сети, что и сервер.
# Играешь только с этой машины — оставь 127.0.0.1.
# Сервер в интернете, а играют все снаружи — поставь то же, что и L2_EXTERNAL_IP.
L2_INTERNAL_IP=127.0.0.1

LOGIN_PORT=2106
GAME_PORT=7777

# Имя сервера в списке (0 = Bartz, 1 = Sieghardt, ... см. docs/OPERATIONS.md)
L2_SERVER_ID=1
L2_MAX_ONLINE=2000

# --- База данных --------------------------------------------------------------
DB_ROOT_PASSWORD=change_me_root
DB_USER=l2j
DB_PASSWORD=change_me_l2j
DB_GAME_NAME=l2jgs
DB_LOGIN_NAME=l2jls
DB_PORT=3306

# Сколько памяти отдать MariaDB под innodb buffer pool.
# Ориентир: 25-40% ОЗУ машины. 2G хватает до ~1000 онлайна.
DB_BUFFER_POOL=2G

# --- JVM ----------------------------------------------------------------------
# Профиль сборщика мусора: g1 (стабильно везде) или zgc (минимальные паузы, Java 21+)
JVM_PROFILE=zgc

# Куча игрового сервера. Ориентир по онлайну:
#   до 50 -> 2G,  до 200 -> 4G,  до 500 -> 6-8G,  1000+ -> 12G и выше.
# Куча + DB_BUFFER_POOL должны с запасом влезать в ОЗУ машины.
GAME_HEAP=4G
LOGIN_HEAP=512M

TZ=Europe/Moscow
