# =============================================================================
#  Lineage 2 Interlude x10 — основные настройки стенда
#  Скопируй в .env  (cp .env.example .env)  и поправь под себя.
# =============================================================================

# --- Что собираем -------------------------------------------------------------
# Исходники L2J Mobius живут на GitLab (не на GitHub).
L2_SOURCE_REPO=https://gitlab.com/MobiusDevelopment/L2J_Mobius.git
L2_SOURCE_BRANCH=master

# Каталог хроники внутри репозитория. AUTO находит Interlude сам.
# У Mobius это L2J_Mobius_CT_0_Interlude (CT_0 = Chronicle Throne 0 = Interlude).
L2_CHRONICLE=AUTO

# Репозиторий огромный (38 хроник). Скачиваем только нужную — это разница
# между ~2 ГБ и десятками ГБ. Выключай только если что-то пошло не так.
L2_SPARSE_CHECKOUT=1

# --- Профиль рейтов -----------------------------------------------------------
L2_PROFILE=x10-classic

# --- Сеть ---------------------------------------------------------------------
# Адрес, который игровой сервер сообщает клиенту.
# 127.0.0.1 — играешь только с этой машины.
# LAN-адрес (192.168.x.x) — играют из локальной сети.
# Белый IP или домен — играют из интернета.
L2_EXTERNAL_IP=127.0.0.1

# Адрес для игроков из той же локальной сети. Если играешь только локально,
# оставь как есть.
L2_INTERNAL_IP=127.0.0.1

LOGIN_PORT=2106
GAME_PORT=7777

L2_SERVER_ID=1
L2_MAX_ONLINE=2000

# --- База данных --------------------------------------------------------------
# У Mobius Interlude игровой и логин-сервер работают с ОДНОЙ базой.
DB_ROOT_PASSWORD=change_me_root
DB_USER=l2j
DB_PASSWORD=change_me_l2j
DB_NAME=l2jmobius
DB_PORT=3306

# Под innodb buffer pool. Ориентир: 25-40% ОЗУ машины.
DB_BUFFER_POOL=2G

# --- JVM ----------------------------------------------------------------------
# Образ, в котором запускается сервер. Менять обычно не нужно.
# Если Docker Hub недоступен, а JDK-образ уже скачан сборкой, подойдёт он:
#   L2_RUNTIME_IMAGE=eclipse-temurin:25-jdk-noble
L2_RUNTIME_IMAGE=eclipse-temurin:25-jre-noble

# Профиль сборщика мусора: zgc (минимальные паузы) или g1.
JVM_PROFILE=zgc

# Куча игрового сервера. Ориентир по онлайну:
#   до 50 -> 2G,  до 200 -> 4G,  до 500 -> 6-8G,  1000+ -> 12G и выше.
# Куча + DB_BUFFER_POOL должны с запасом влезать в ОЗУ машины.
GAME_HEAP=4G
LOGIN_HEAP=512M

TZ=Europe/Moscow
