+import type { Lang } from '../types.js';
+
+/**
+ * Тексты уведомлений на языке получателя.
+ *
+ * Было две разные практики: payments.ts выбирал язык по user.language
+ * (`const ar = user.language === 'ar'`), а routes/index.ts склеивал оба языка
+ * в одну строку через слэш — «Cette annonce n'est plus disponible / لم يعد
+ * الإعلان متاحًا». Такой пуш вдвое длиннее лимита превью на Android и
+ * показывает половину текста на языке, которого человек не выбирал.
+ *
+ * Здесь общий словарь: ключ → {fr, ar}. Значения — функции там, где в текст
+ * подставляются данные.
+ *
+ * Эмодзи в заголовках (🔔 💚 ✅ ❌) убраны: регламент проекта их запрещает
+ * (CLAUDE.md, «Avoid: emojis»), а у уведомления и так есть поле `type` —
+ * по нему клиент рисует иконку своим набором.
+ */
+
+export const pick = (lang: Lang | undefined, fr: string, ar: string): string =>
+  lang === 'ar' ? ar : fr;
+
+export const notifyText = {
+  /** Новое объявление по сохранённому поиску. Без имени — общий заголовок. */
+  savedSearch: (lang: Lang | undefined, name: string): string =>
+    name || pick(lang, 'Nouvelle annonce', 'إعلان جديد'),
+
+  /** Цена снизилась у объявления в избранном. */
+  priceDropBody: (lang: Lang | undefined, oldPrice: number, newPrice: number): string =>
+    pick(lang,
+      `Prix baissé : ${oldPrice} → ${newPrice} DA`,
+      `انخفض السعر: ${oldPrice} ← ${newPrice} دج`),
+
+  /** Объявление из избранного снято с публикации. */
+  closedBody: (lang: Lang | undefined): string =>
+    pick(lang, "Cette annonce n'est plus disponible", 'لم يعد الإعلان متاحًا'),
+
+  /** Заявка на верификацию одобрена. */
+  verifiedTitle: (lang: Lang | undefined): string =>
+    pick(lang, 'Compte vérifié', 'تم توثيق الحساب'),
+
+  /** Заявка на верификацию отклонена. */
+  rejectedTitle: (lang: Lang | undefined): string =>
+    pick(lang, 'Vérification refusée', 'تم رفض التوثيق'),
+
+  /** Пометка «сообщение с фото» в превью пуша. */
+  photoNote: (lang: Lang | undefined, count: number): string =>
+    count > 1
+      ? pick(lang, `${count} photos`, `${count} صور`)
+      : pick(lang, 'Photo', 'صورة'),
+};
