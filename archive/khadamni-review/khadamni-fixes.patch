+export function signToken(user: Pick<User, 'id' | 'tokenVersion'>): string {
+  // В токен кладём минимум: id пользователя и версию сессий (tv).
+  // tv нужен, чтобы токен вообще можно было отозвать: он сверяется с
+  // users.token_version на каждом запросе, и инкремент версии (смена пароля,
+  // «выйти везде») мгновенно обесценивает все ранее выданные токены.
+  return jwt.sign({ sub: user.id, tv: user.tokenVersion ?? 0 }, JWT_SECRET, { expiresIn: JWT_EXPIRES });
+}
+
+/**
+ * Токен выпущен до последнего отзыва сессий?
+ * Токены, выпущенные до появления клейма (tv отсутствует), считаем версией 0 —
+ * они остаются валидными для тех, у кого версия ещё 0, и гаснут при первом же
+ * отзыве. Иначе релиз разлогинил бы всех разом.
+ */
+function isRevoked(payload: jwt.JwtPayload, user: User): boolean {
+  const tv = typeof payload.tv === 'number' ? payload.tv : 0;
+  return tv !== (user.tokenVersion ?? 0);
 }
 
