+    const N = Number(n), R = Number(r), P = Number(p);
+    if (!Number.isFinite(N) || !Number.isFinite(R) || !Number.isFinite(P) || !salt || !hash) return null;
+    return { n: N, r: R, p: P, salt, hash };
+  }
+  // Старый формат: scrypt$salt$hash (параметров нет — они были дефолтными).
+  if (parts.length === 3) {
