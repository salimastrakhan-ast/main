+import fs from 'fs';
+import path from 'path';
+
+/**
+ * Страж RTL-инварианта.
+ *
+ * Приложение сознательно НЕ включает I18nManager.forceRTL (см. services/rtl.ts):
+ * язык переключается без перезапуска. Плата за это — зеркалить приходится
+ * вручную, через row() / textAlign() / side() / edge(). И у такого подхода есть
+ * тихий отказ: забыл вызов — экран просто рендерится по-латински, ошибки нет
+ * ни в типах, ни в рантайме, видно только глазами и только на арабском.
+ * Скелетон в WalletScreen так и жил сломанным.
+ *
+ * RTL-тесты покрывают два экрана из девятнадцати, писать их на все — дорого.
+ * Этот тест дешевле: он не проверяет вёрстку, а запрещает сам класс записи,
+ * который не умеет зеркалиться. Тот же приём, что в tokens.test.ts, где один
+ * тест стережёт согласованность палитры приложения и веба.
+ *
+ * Почему нельзя просто разрешить нативные start/end: forceRTL выключен, значит
+ * I18nManager.isRTL всегда false, и RN разложит marginStart в marginLeft на
+ * обоих языках. Отсюда edge()/side(), считающие сторону по текущему языку.
+ */
+
+const SRC = path.resolve(__dirname, '../..');
+
+/** Стороннезависимые свойства, которые в арабском уедут не в ту сторону. */
+const FORBIDDEN: { re: RegExp; what: string; instead: string }[] = [
+  {
+    re: /textAlign:\s*'(left|right)'/g,
+    what: "textAlign: 'left' | 'right'",
+    instead: "textAlign() из services/rtl",
+  },
+  {
+    re: /(margin|padding)(Left|Right):\s*[\d-]/g,
+    what: 'marginLeft/Right, paddingLeft/Right с числом',
+    instead: "[`margin${edge('Left')}`] или симметричные marginHorizontal",
+  },
+  {
+    re: /^\s*(left|right):\s*[\d-]/gm,
+    what: 'абсолютные left/right',
+    instead: "{ [side('right')]: N } — сторона считается по языку",
+  },
+];
+
+function sourceFiles(dir: string, acc: string[] = []): string[] {
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    const full = path.join(dir, entry.name);
+    if (entry.isDirectory()) {
+      if (entry.name === '__tests__' || entry.name === 'node_modules') continue;
+      sourceFiles(full, acc);
+    } else if (/\.tsx?$/.test(entry.name)) {
+      acc.push(full);
+    }
+  }
+  return acc;
+}
+
+describe('RTL: в стилях нет свойств, которые не зеркалятся', () => {
+  const files = sourceFiles(SRC);
+
+  it('находит исходники приложения', () => {
+    expect(files.length).toBeGreaterThan(30);
+  });
+
+  for (const { re, what, instead } of FORBIDDEN) {
+    it(`нигде не используется ${what}`, () => {
+      const hits: string[] = [];
+      for (const file of files) {
+        const text = fs.readFileSync(file, 'utf8');
+        const rx = new RegExp(re.source, re.flags);
+        let m: RegExpExecArray | null;
+        while ((m = rx.exec(text)) !== null) {
+          const line = text.slice(0, m.index).split('\n').length;
+          hits.push(`${path.relative(SRC, file)}:${line}  ${m[0].trim()}`);
+        }
+      }
+      // Сообщение кладём в само сравниваемое значение: jest, в отличие от
+      // vitest, второй аргумент expect не принимает, а список нарушений
+      // должен быть виден прямо в выводе упавшего теста.
+      const report = hits.length
+        ? `Не зеркалится в арабском — используй ${instead}:\n${hits.join('\n')}`
+        : '';
+      expect(report).toBe('');
+    });
+  }
+});
