# Настройки боевого контура.
#
#   cp deploy/env.example deploy/.env
#
# Файл .env в репозиторий не попадает — в нём пароли.

# --- Домен ---
#
# Три имени должны указывать на эту машину ДО первого запуска: сам домен,
# api.<домен> и media.<домен>. Сертификаты Caddy выпустит сам, но только
# если Let's Encrypt сможет достучаться до них по 80 порту.
TITO_DOMAIN=tito.example
TITO_ACME_EMAIL=admin@tito.example

# --- Секрет подписи токенов ---
#
# От 16 байт; сервер откажется стартовать без него вне dev. Смена секрета
# разлогинивает всех разом — это нормальный способ отозвать все сессии.
#
#   openssl rand -base64 48
TITO_JWT_SECRET=

# --- База ---
#
#   openssl rand -base64 24
TITO_PG_USER=tito
TITO_PG_PASSWORD=
TITO_PG_DB=tito

# --- Хранилище файлов ---
#
# Ключ от трёх символов, секрет от восьми — так требует MinIO.
#
#   openssl rand -hex 16
TITO_S3_ACCESS_KEY=
TITO_S3_SECRET_KEY=
TITO_S3_BUCKET=tito-media
TITO_MAX_UPLOAD_MB=50

# --- SMS ---
#
# Без ключа сервер запустится, но коды подтверждения будут уходить в лог
# вместо телефона — войти не сможет никто, кроме того, кто читает логи.
# Ключ выдаётся в личном кабинете sms.ru. Имя отправителя необязательно и
# требует отдельного согласования у провайдера.
TITO_SMSRU_API_KEY=
TITO_SMSRU_FROM=

# --- Звонки ---------------------------------------------------------------
#
# Без этих двух переменных звонки работают только там, где сеть позволяет
# прямое соединение: дома и в офисе — да, через мобильного оператора — часто
# нет. Пустой секрет означает «раздавать клиентам только STUN».
#
# Секрет — общий с coturn, длинный и случайный:
#   openssl rand -hex 32
TITO_TURN_SECRET=
# Белый внешний адрес сервера. coturn раздаёт его клиентам, и подставить
# сюда внутренний — значит раздать адрес, по которому до вас не дозвониться.
TITO_PUBLIC_IP=
# Сколько живёт выписанный пароль. Меньше суток — чтобы вытащенный из
# приложения не пригодился надолго.
TITO_TURN_TTL=12h
