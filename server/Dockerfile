# Сборка сервера.
#
# Версия Go взята из go.mod дословно. Сборщик умеет докачать нужный тулчейн
# сам, но образ, который собирается только при доступе в интернет, — не
# образ.
FROM golang:1.25-alpine AS build

WORKDIR /src

# Зависимости отдельным слоем: они меняются куда реже кода, и правка одной
# строки не тянет заново весь модуль.
COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ ./

# CGO не нужен: pgx и minio-go на чистом Go. Без него бинарник статический и
# запускается в образе без единой библиотеки.
#
# Флаги -s -w выкидывают таблицу символов и отладочную информацию: на
# трассировки паник это не влияет, а бинарник худеет примерно на четверть.
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags='-s -w' -o /out/api ./cmd/api

# --- Готовый образ ---
#
# Пустой: ни пакетного менеджера, ни shell. Это не экономия мегабайтов, а
# отсутствие того, чем можно воспользоваться, если в сервере найдут дыру.
FROM scratch

# Корневые сертификаты нужны для исходящих HTTPS: sms.ru и хранилище за
# TLS. Без них сервер молча не отправит ни одного кода.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
# Часовых поясов тут нет намеренно: сервер везде работает в UTC, а
# «сегодня» и «вчера» в ленте считают клиенты по времени устройства.

COPY --from=build /out/api /api

# Не root. Имени у пользователя нет — в образе нет /etc/passwd, — но ядру
# хватает номера.
USER 10001:10001

EXPOSE 8080

# Проверку живости делает сам бинарник: shell и wget тут не из чего взять.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
  CMD ["/api", "-healthcheck"]

ENTRYPOINT ["/api"]
